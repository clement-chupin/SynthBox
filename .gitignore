# PlatformIO build artifacts
.pio/
.pioenvs/
.piolibdeps/

# VSCode (PlatformIO-generated config files)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.clang_complete
compile_commands.json

# Desktop simulator build artifacts
simulator/build/

# Android native (SDL2) build artifacts — see android-native/.gitignore for details
android-native/app/build/
android-native/app/.cxx/
android-native/.gradle/
android-native/local.properties
android-native/SDL2/

# Keep only the packaged APK to publish
!releases/*.apk
